#!/usr/sbin/nft -f
# Serveur Barbacane : pare-feu en LISTE BLANCHE (docs/suite/serveur-iso.md §4).
#   entrée : la passerelle (port tiré à l'installation, D4) sur l'interface « bornes » seulement,
#            l'interface web (administration) sur l'interface « administration » seulement ;
#   sortie : réponses aux connexions établies seulement (le serveur n'initie rien) ;
#   transit : jamais (aucun routage entre les deux réseaux).
# Généré à l'installation par configurer-serveur.sh ; tout refus est journalisé (débit limité).
flush ruleset

table inet barbacane {
    chain entree {
        type filter hook input priority filter; policy drop;
        iif "lo" accept
        ct state invalid drop
        ct state established,related accept
        iifname "@IF_BORNES@" ip daddr @IP_BORNES@ tcp dport @PORT@ ct state new accept
        iifname "@IF_ADMIN@" tcp dport @PORT_ADMIN@ ct state new accept
        limit rate 6/minute log prefix "barbacane-refus-entree " level warn
    }

    chain transit {
        type filter hook forward priority filter; policy drop;
        limit rate 6/minute log prefix "barbacane-refus-transit " level warn
    }

    chain sortie {
        type filter hook output priority filter; policy drop;
        oif "lo" accept
        ct state established,related accept
        @SORTIE_HEURE@
        limit rate 6/minute log prefix "barbacane-refus-sortie " level warn
    }
}
