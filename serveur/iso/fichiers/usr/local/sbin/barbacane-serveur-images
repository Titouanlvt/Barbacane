#!/bin/sh
# Charge dans le stockage Podman de l'utilisateur courant (barbacane-svc) les images embarquées
# dans l'ISO du serveur, si elles n'y sont pas déjà. Aucun registre, aucun réseau.
#   barbacane-serveur-images VERSION
set -eu
v=$1
for n in passerelle web; do
    podman image exists "localhost/barbacane-$n:$v" && continue
    podman import --change "ENTRYPOINT=[\"/barbacane-$n\"]" "/usr/share/barbacane-serveur/images/$n.tar" "localhost/barbacane-$n:$v"
done
