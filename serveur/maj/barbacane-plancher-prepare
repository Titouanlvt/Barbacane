#!/bin/bash
# Prépare un PLANCHER de version signé hors ligne pour le serveur Barbacane
# (docs/suite/serveur-maj-audit.md §2.2) : le serveur refusera tout .bcu de version inférieure.
# À lancer sur le poste HORS LIGNE qui détient la clé de signature des .bcu (même clé).
#
#   barbacane-plancher-prepare --cle secret.key --version-min N --sortie DOSSIER
#
# Produit DOSSIER/plancher.json et DOSSIER/plancher.json.minisig, à installer sur le serveur :
#   barbacane-registre CONFIG maj-plancher DOSSIER/plancher.json
set -euo pipefail

die() { echo "ERREUR : $*" >&2; exit 1; }

CLE='' VMIN='' SORTIE=''
while [ $# -gt 0 ]; do
    case "$1" in
        --cle) CLE="$2"; shift 2 ;;
        --version-min) VMIN="$2"; shift 2 ;;
        --sortie) SORTIE="$2"; shift 2 ;;
        -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
        *) die "option inconnue : $1 (voir --help)" ;;
    esac
done
[ -f "$CLE" ] || die "--cle : clé secrète minisign introuvable"
[[ "$VMIN" =~ ^[0-9]{1,19}$ ]] || die "--version-min doit être un entier"
[ -n "$SORTIE" ] || die "--sortie obligatoire"
command -v minisign >/dev/null || die "outil manquant : minisign"
VMIN=$((10#$VMIN))
mkdir -p "$SORTIE"
[ ! -e "$SORTIE/plancher.json" ] || die "$SORTIE/plancher.json existe déjà"

printf '{"format":1,"usage":"barbacane-plancher-maj","version_min":%s}' "$VMIN" > "$SORTIE/plancher.json"
minisign -S -s "$CLE" -m "$SORTIE/plancher.json" -t "barbacane-plancher-maj version_min $VMIN" \
    || die "signature échouée"
PUB="${CLE%.key}.pub"
if [ -f "$PUB" ]; then
    minisign -V -p "$PUB" -m "$SORTIE/plancher.json" >/dev/null || die "la signature ne se vérifie pas avec $PUB"
fi
echo "Plancher $VMIN : $SORTIE/plancher.json (+ .minisig)"
