[Unit]
Description=Barbacane : analyseur de fichiers (ClamAV + YARA, archives)
After=clamav-daemon.service barbacane-travail.service
Wants=clamav-daemon.service
Requires=barbacane-travail.service

[Service]
ExecStart=/usr/bin/barbacane-analyzer -c /etc/barbacane/analyzer.toml
Environment=RUST_LOG=info
User=barbacane-analyzer
Group=barbacane
SupplementaryGroups=clamav
UMask=0027
# Fichiers en cours d'analyse : volume chiffré éphémère (barbacane-travail), sur disque mais
# illisible après redémarrage ; la taille suit le disque, pas la RAM (8 Go : tmpfs de 6 Go plein).
ReadWritePaths=/var/lib/barbacane/travail/analyse
StateDirectory=barbacane/rapports barbacane/sortie barbacane/import
StateDirectoryMode=0750
MemoryMax=10G
CPUQuota=300%
TasksMax=256
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
# Pas de RestrictSUIDSGID : son filtre seccomp fait échouer les montages de bubblewrap 0.12
# (« Can't open source /usr: Function not implemented ») ; NoNewPrivileges=yes et les montages
# nosuid de bwrap empêchent déjà tout gain de privilège par setuid/setgid.
LockPersonality=yes
# bubblewrap a besoin des espaces de noms utilisateur
RestrictNamespaces=user mnt pid ipc net uts cgroup
# AF_NETLINK : bubblewrap configure la boucle locale de son espace réseau isolé (sans lui,
# bwrap sort en erreur et TOUTE archive était refusée comme « corrompue », 15/11/2026)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressAllow=localhost
IPAddressDeny=any
CapabilityBoundingSet=
SystemCallArchitectures=native
# bubblewrap : espaces de noms et montages dans son propre espace
SystemCallFilter=@system-service @mount @sandbox
SystemCallFilter=~@obsolete @raw-io @reboot @swap @module @clock @cpu-emulation @debug
Restart=on-failure

[Install]
WantedBy=multi-user.target
