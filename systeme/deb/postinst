#!/bin/sh
# Paquet barbacane : comptes, dossiers, réglages système, services.
set -e

if [ "$1" = "configure" ] || [ "$1" = "reconfigure" ]; then
    getent group barbacane >/dev/null || addgroup --system barbacane
    getent group barbacane-kiosk >/dev/null || addgroup --system barbacane-kiosk
    id -u barbacane-analyzer >/dev/null 2>&1 || \
        adduser --system --ingroup barbacane --home /nonexistent --no-create-home barbacane-analyzer
    id -u barbacane-kiosk >/dev/null 2>&1 || \
        adduser --system --ingroup barbacane-kiosk --home /var/lib/barbacane-kiosk barbacane-kiosk
    # Disques optiques : compte dédié, groupe barbacane (usbsas lit le dossier d'entrée),
    # groupe cdrom (lecteur)
    id -u barbacane-optique >/dev/null 2>&1 || \
        adduser --system --ingroup barbacane --home /nonexistent --no-create-home barbacane-optique
    if getent group cdrom >/dev/null; then adduser --quiet barbacane-optique cdrom; fi
    # Interface : socket usbsas (groupe usbsas), rendu graphique
    for g in usbsas video render input; do
        if getent group "$g" >/dev/null; then adduser --quiet barbacane-kiosk "$g"; fi
    done
    # usbsas lit les dossiers préparés par l'analyseur
    if id -u usbsas >/dev/null 2>&1; then adduser --quiet usbsas barbacane; fi
    # Analyseur : socket clamd
    if getent group clamav >/dev/null; then adduser --quiet barbacane-analyzer clamav; fi

    install -d -m 0755 /var/lib/barbacane /var/lib/barbacane/yara /var/lib/barbacane/listes
    # Ancien tmpfs de 6 Go de l'analyseur (débordait avec une clé de 5,5 Go sur 8 Go de RAM) :
    # remplacé par le volume chiffré éphémère barbacane-travail.
    rm -f /etc/systemd/system/barbacane-analyzer.service.d/tmpfs.conf
    rmdir /etc/systemd/system/barbacane-analyzer.service.d 2>/dev/null || true
    install -d -m 0700 -o usbsas -g usbsas /var/lib/usbsas/tmp 2>/dev/null || true
    # Anciens dossiers de session EN CLAIR (fichiers sains préparés, contenu des disques
    # optiques) : déplacés dans le volume chiffré éphémère le 17/11/2026 ; restes supprimés.
    rm -rf /var/lib/barbacane/sortie /var/lib/barbacane/optique/entree /var/lib/barbacane/optique/travail

    # clamd : limites d'analyse imposées (fichier généré par debconf, réglages remplacés ligne à ligne)
    if [ -f /etc/clamav/clamd.conf ]; then
        grep -vE '^\s*(#|$)' /usr/share/barbacane/clamd-barbacane.conf | while read -r cle valeur; do
            sed -i "/^$cle /d" /etc/clamav/clamd.conf
            echo "$cle $valeur" >> /etc/clamav/clamd.conf
        done
    fi

    # usbsas (amont 97ada8b, v2.0.3) attend le résultat d'analyse 30 min par défaut : 12 h sur les
    # bornes mises à jour aussi (leur /etc/usbsas/config.toml est local, jamais remplacé).
    C=/etc/usbsas/config.toml
    if [ -f "$C" ] && grep -q '^\[analyzer\]' "$C" && ! grep -q '^poll_timeout' "$C"; then
        sed -i '/^\[analyzer\]/a poll_timeout = 43200' "$C"
    fi
    # v2.1.0 (écart n° 14) : usbsas relit lui-même la liste signée des images officielles
    if [ -f "$C" ] && ! grep -q '^official_images' "$C"; then
        sed -i '1i official_images = "/var/lib/barbacane/listes/images-officielles.sha256"' "$C"
    fi

    systemctl daemon-reload >/dev/null 2>&1 || true
    sysctl --system >/dev/null 2>&1 || true
    udevadm control --reload-rules >/dev/null 2>&1 || true
    # Borne hors ligne : pas de mise à jour réseau des signatures
    systemctl disable --now clamav-freshclam.service >/dev/null 2>&1 || true
    for s in clamav-daemon nftables barbacane-travail usbsas-server barbacane-analyzer barbacane-admind barbacane-optique barbacane-kiosk hid-dealer; do
        systemctl enable "$s.service" >/dev/null 2>&1 || true
    done
    systemctl mask getty@tty2.service autovt@tty2.service >/dev/null 2>&1 || true
    systemctl set-default graphical.target >/dev/null 2>&1 || true
    # Redémarrage de l'analyseur après une mise à jour (si systemd tourne). JAMAIS d'admind : c'est
    # lui qui exécute apt pendant une mise à jour hors ligne ; le redémarrer tuerait apt en pleine
    # installation (lab 18/11 : « réponse invalide : EOF »). admind fait redémarrer la borne ensuite.
    if [ -d /run/systemd/system ]; then
        systemctl try-restart barbacane-analyzer.service >/dev/null 2>&1 || true
    fi
fi

