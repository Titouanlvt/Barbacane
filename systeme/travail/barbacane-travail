#!/bin/sh
# Espace de travail chiffré éphémère de la borne (usbsas + analyseur).
#
# Les fichiers lus sur les clés passent par le disque (archive tar de session d'usbsas, copie de
# l'analyseur, extraction des archives). Ils sont écrits dans un volume dm-crypt dont la clé est
# tirée de /dev/urandom et jamais écrite. Le volume est RECRÉÉ (nouvelle clé) :
#   - à chaque démarrage de la borne ;
#   - à la fin de chaque session utilisateur (`barbacane-travail nouvelle-session`, demandé par
#     l'interface au retour à l'accueil, via le service d'administration).
# L'ancienne clé n'existant plus, rien de ce qui a été lu sur une clé ne reste lisible sur le
# disque, même si le fichier support n'est pas effacé octet par octet (choix justifié dans
# docs/conception-espace-travail.md : effacer des centaines de Go à chaque session serait trop long
# et usant pour un SSD ; jeter la clé a le même effet pour un attaquant).
#
# Taille, calculée à chaque démarrage (fichier creux : rien n'est alloué tant qu'il n'est pas
# écrit), réglable dans /etc/barbacane/travail.conf :
#   PART      part du disque interne (défaut 50 %)
#   PLANCHER  taille minimale en Gio (défaut 8)
#   PLAFOND   taille maximale en Gio (défaut : aucune)
# et toujours au plus 80 % de l'espace libre (le système doit garder de la place).
#
#   barbacane-travail demarrer | arreter | nouvelle-session | taille
set -eu
IMAGE=/var/lib/barbacane-travail.img
NOM=barbacane-travail
POINT=/var/lib/barbacane/travail
PART=50 PLANCHER=8 PLAFOND=0
# shellcheck disable=SC1091 # fichier de la borne
[ ! -r /etc/barbacane/travail.conf ] || . /etc/barbacane/travail.conf

# Taille du volume en Kio
taille() {
    d=$(dirname "$IMAGE")
    disque=$(df -Pk "$d" | awk 'NR==2 {print $2}')
    libre=$(df -Pk "$d" | awk 'NR==2 {print $4}')
    [ ! -f "$IMAGE" ] || libre=$((libre + $(du -k "$IMAGE" | cut -f1)))
    t=$((disque * PART / 100))
    [ "$PLAFOND" -eq 0 ] || [ "$t" -le $((PLAFOND * 1024 * 1024)) ] || t=$((PLAFOND * 1024 * 1024))
    [ "$t" -le $((libre * 80 / 100)) ] || t=$((libre * 80 / 100))
    [ "$t" -ge $((PLANCHER * 1024 * 1024)) ] || t=$((PLANCHER * 1024 * 1024))
    echo "$t"
}

demarrer() {
    arreter 2>/dev/null || true
    t=$(taille)
    rm -f "$IMAGE"                       # blocs rendus au disque ; leur contenu est indéchiffrable
    truncate -s "${t}K" "$IMAGE"
    chmod 600 "$IMAGE"
    # Clé de 512 bits lue dans /dev/urandom, passée à dm-crypt puis oubliée (mode « plain » :
    # aucun en-tête, rien à conserver).
    cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 \
        --key-file /dev/urandom "$IMAGE" "$NOM"
    mkfs.ext4 -q -F -m 0 -E nodiscard,lazy_itable_init=1 -L travail "/dev/mapper/$NOM"
    mkdir -p "$POINT"
    mount -o nodev,nosuid,noexec "/dev/mapper/$NOM" "$POINT"
    chmod 755 "$POINT"
    install -d -m 0700 -o usbsas -g usbsas "$POINT/usbsas"
    install -d -m 0700 -o barbacane-analyzer -g barbacane "$POINT/analyse"
    # Fichiers sains préparés (lus par usbsas et le graveur) et contenu des disques optiques :
    # données de session, donc dans le volume chiffré aussi.
    install -d -m 0750 -o barbacane-analyzer -g barbacane "$POINT/sortie"
    if id barbacane-optique >/dev/null 2>&1; then
        install -d -m 0750 -o barbacane-optique -g barbacane "$POINT/optique" \
            "$POINT/optique/entree" "$POINT/optique/travail"
    fi
    rmdir "$POINT/lost+found" 2>/dev/null || true
    echo "espace de travail : $((t / 1024 / 1024)) Gio (clé neuve)"
}

arreter() {
    if mountpoint -q "$POINT"; then umount "$POINT"; fi
    if [ -e "/dev/mapper/$NOM" ]; then cryptsetup close "$NOM"; fi
}

case "${1:-}" in
    demarrer) demarrer ;;
    arreter) arreter ;;
    # Fin de session : usbsas et l'analyseur dépendent du volume (Requires=) et redémarrent avec lui
    nouvelle-session) systemctl restart barbacane-travail.service ;;
    taille) echo "$(($(taille) / 1024 / 1024)) Gio" ;;
    *) echo "usage : $0 demarrer|arreter|nouvelle-session|taille" >&2; exit 2 ;;
esac
